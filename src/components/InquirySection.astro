---
import { ui } from '../i18n/ui';
import { MAX_LENGTH } from '../lib/inquiry';

const t = ui.ko;
const tel = (v: string) => 'tel:' + v.replace(/[^0-9+]/g, '');

// Rendered by `field()` below: label, control, and the error slot the form
// script fills in (`data-error-for`).
const textFields = [
  { name: 'company', key: 'inquiry.company', type: 'text', autocomplete: 'organization', optional: true },
  { name: 'name', key: 'inquiry.name', type: 'text', autocomplete: 'name', optional: false },
  { name: 'phone', key: 'inquiry.phone', type: 'tel', autocomplete: 'tel', optional: false },
  { name: 'email', key: 'inquiry.email', type: 'email', autocomplete: 'email', optional: false },
] as const;
---

<section id="contact" class="section border-t border-line dark:border-night-line" aria-labelledby="inquiry-title">
  <div class="container-custom grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-12 lg:gap-16 items-start">
    <!-- Intro + direct contacts -->
    <div>
      <p class="label">CONTACT</p>
      <h2 id="inquiry-title" class="mt-4 text-[32px] md:text-[44px] font-bold leading-tight tracking-[-0.04em] text-ink dark:text-snow" data-i18n="inquiry.title">{t['inquiry.title']}</h2>
      <p class="mt-4 max-w-[440px] text-base leading-[1.7] text-ink-soft dark:text-snow-soft" data-i18n="inquiry.lead">{t['inquiry.lead']}</p>
      <dl class="mt-9 border-t border-line dark:border-night-line">
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-4 border-b border-line dark:border-night-line">
          <dt class="text-sm text-ink-mute dark:text-snow-mute" data-i18n="contact.phone">{t['contact.phone']}</dt>
          <dd><a href={tel(t['contact.phoneValue'])} class="focus-ring rounded-sm font-display text-lg font-semibold hover:text-accent dark:hover:text-accent-light transition-colors" data-i18n="contact.phoneValue">{t['contact.phoneValue']}</a></dd>
        </div>
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-4 border-b border-line dark:border-night-line">
          <dt class="text-sm text-ink-mute dark:text-snow-mute" data-i18n="contact.mobile">{t['contact.mobile']}</dt>
          <dd><a href={tel(t['contact.mobileValue'])} class="focus-ring rounded-sm font-display text-lg font-semibold hover:text-accent dark:hover:text-accent-light transition-colors" data-i18n="contact.mobileValue">{t['contact.mobileValue']}</a></dd>
        </div>
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-4 border-b border-line dark:border-night-line">
          <dt class="text-sm text-ink-mute dark:text-snow-mute" data-i18n="contact.email">{t['contact.email']}</dt>
          <dd><a href="mailto:kynam@topvac.co.kr" class="focus-ring rounded-sm font-display text-lg font-semibold break-all hover:text-accent dark:hover:text-accent-light transition-colors" data-i18n="contact.emailValue">{t['contact.emailValue']}</a></dd>
        </div>
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-4 py-4 border-b border-line dark:border-night-line">
          <dt class="text-sm text-ink-mute dark:text-snow-mute" data-i18n="contact.address">{t['contact.address']}</dt>
          <dd class="text-base font-semibold" data-i18n="contact.addressValue">{t['contact.addressValue']}</dd>
        </div>
      </dl>
    </div>

    <!-- Inquiry form → email (see src/lib/inquiry.ts) -->
    <form id="inquiry" data-inquiry-form novalidate class="scroll-mt-28 rounded-[20px] bg-paper dark:bg-night-raised p-6 md:p-9 flex flex-col gap-5">
      <!-- Honeypot for bots; hidden from people and assistive tech -->
      <div class="hidden" aria-hidden="true">
        <label>Leave this empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {textFields.map((f) => (
          <div class="flex flex-col gap-1.5">
            <label for={`iq-${f.name}`} class="text-[13px] font-bold text-ink dark:text-snow">
              <span data-i18n={f.key}>{t[f.key]}</span>
              {f.optional && <span class="font-medium text-ink-mute dark:text-snow-mute" data-i18n="inquiry.optional">{t['inquiry.optional']}</span>}
            </label>
            <input
              id={`iq-${f.name}`}
              name={f.name}
              type={f.type}
              autocomplete={f.autocomplete}
              maxlength={MAX_LENGTH[f.name]}
              required={!f.optional}
              aria-describedby={`iq-${f.name}-error`}
              class="input"
            />
            <p id={`iq-${f.name}-error`} data-error-for={f.name} class="field-error"></p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="iq-model" class="text-[13px] font-bold text-ink dark:text-snow">
          <span data-i18n="inquiry.model">{t['inquiry.model']}</span>
          <span class="font-medium text-ink-mute dark:text-snow-mute" data-i18n="inquiry.optional">{t['inquiry.optional']}</span>
        </label>
        <input id="iq-model" name="model" type="text" maxlength={MAX_LENGTH.model} aria-describedby="iq-model-error" class="input" data-i18n-placeholder="inquiry.modelPlaceholder" placeholder={t['inquiry.modelPlaceholder']} />
        <p id="iq-model-error" data-error-for="model" class="field-error"></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="iq-message" class="text-[13px] font-bold text-ink dark:text-snow" data-i18n="inquiry.message">{t['inquiry.message']}</label>
        <textarea id="iq-message" name="message" rows="6" maxlength={MAX_LENGTH.message} required aria-describedby="iq-message-error" class="input h-auto py-3 resize-y"></textarea>
        <p id="iq-message-error" data-error-for="message" class="field-error"></p>
      </div>

      <button type="submit" class="btn-primary w-full disabled:opacity-60 disabled:cursor-wait">
        <span data-i18n="inquiry.submit">{t['inquiry.submit']}</span>
      </button>
      <p data-inquiry-status role="status" aria-live="polite" class="inquiry-status"></p>
    </form>
  </div>

  <!-- Localhost only: shows the email that would be sent (nothing is sent). -->
  <dialog data-inquiry-preview class="inquiry-preview" aria-labelledby="iq-preview-title">
    <form method="dialog" class="flex flex-col gap-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="label">LOCALHOST PREVIEW</p>
          <h3 id="iq-preview-title" class="mt-1 text-lg font-bold">사장님이 받게 될 메일 (실제로 발송되지 않음)</h3>
        </div>
        <button type="submit" class="icon-btn shrink-0" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <dl class="grid grid-cols-[80px_minmax(0,1fr)] gap-x-3 gap-y-1 text-sm">
        <dt class="text-ink-mute dark:text-snow-mute">받는 사람</dt><dd data-preview="to"></dd>
        <dt class="text-ink-mute dark:text-snow-mute">답장 주소</dt><dd data-preview="replyTo"></dd>
        <dt class="text-ink-mute dark:text-snow-mute">제목</dt><dd class="font-semibold" data-preview="subject"></dd>
      </dl>
      <table class="w-full text-sm border border-line dark:border-night-line">
        <tbody data-preview="rows"></tbody>
      </table>
    </form>
  </dialog>
</section>

<script>
  import { mountInquiryForm, showInquiryPreview } from '../lib/inquiry-form';

  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  const preview = document.querySelector<HTMLDialogElement>('[data-inquiry-preview]');
  if (form) {
    mountInquiryForm(form, {
      onDryRun: (mail, to) => preview && showInquiryPreview(preview, mail, to),
    });
  }
</script>
