---
interface Props {
  partNumber: string;
  nameKo: string;
  nameEn: string;
  image: string;
  price: string;
  rawPrice: number;
  category: string;
  descriptionKo?: string;
  descriptionEn?: string;
  bestSeller?: boolean;
}

const { partNumber, nameKo, nameEn, image, price, rawPrice, category, descriptionKo, descriptionEn, bestSeller } = Astro.props;
---

<div
  class="product-card card-flip cursor-pointer h-full"
  data-category={category}
  data-price={rawPrice}
  data-best-seller={bestSeller ? '1' : '0'}
  data-part-number={partNumber}
>
  <div class="card-inner">
    <!-- Front -->
    <div class="card-front h-full flex flex-col rounded-2xl overflow-hidden bg-white dark:bg-night border border-line dark:border-night-line hover:border-ink dark:hover:border-snow transition-colors">
      <div class="relative aspect-square bg-white">
        <img
          src={image}
          alt={nameKo}
          class="w-full h-full object-contain p-4"
          onerror="this.src='/images/placeholder-product.svg'"
          loading="lazy"
          decoding="async"
        />
        {bestSeller && (
          <span class="absolute left-3 top-3 rounded-md bg-accent px-2 py-1 font-display text-[10px] font-bold tracking-[0.1em] text-white" data-i18n="products.bestSeller">BEST</span>
        )}
      </div>
      <div class="p-4 mt-auto border-t border-line dark:border-night-line">
        <p class="text-xs text-ink-mute dark:text-snow-mute mb-0.5">{partNumber}</p>
        <h3 class="product-name font-bold text-ink dark:text-snow text-base min-h-[2.5rem] line-clamp-2" data-name-ko={nameKo} data-name-en={nameEn}>{nameKo}</h3>
        {(descriptionKo || descriptionEn) && (
          <p class="product-desc mt-1 text-sm text-ink-soft dark:text-snow-soft" data-desc-ko={descriptionKo || ''} data-desc-en={descriptionEn || ''}>{descriptionKo}</p>
        )}
        <p class="mt-2 font-display text-lg font-bold text-ink dark:text-snow">{price}</p>
        <p class="mt-2 flex items-center gap-1 text-[11px] text-ink-mute dark:text-snow-mute">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span data-i18n="products.tapToFlip">상세정보 보기</span>
        </p>
      </div>
    </div>

    <!-- Back -->
    <div class="card-back flex flex-col items-center justify-center rounded-2xl overflow-hidden bg-white dark:bg-night border border-ink dark:border-snow p-6 text-center">
      <p class="text-xs text-ink-mute dark:text-snow-mute mb-2">{partNumber}</p>
      <h3 class="product-name font-bold text-ink dark:text-snow text-base mb-1" data-name-ko={nameKo} data-name-en={nameEn}>{nameKo}</h3>
      <p class="font-display text-lg font-bold text-ink dark:text-snow mb-6">{price}</p>
      <div class="w-12 h-12 bg-paper dark:bg-night-high rounded-full flex items-center justify-center mb-3">
        <svg class="w-6 h-6 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <p class="text-sm text-ink-soft dark:text-snow-soft" data-i18n="products.detailComingSoon">상세정보 준비중입니다</p>
    </div>
  </div>
</div>
