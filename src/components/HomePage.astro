---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import InquirySection from './InquirySection.astro';
import ProductCard from './ProductCard.astro';
import { ui } from '../i18n/ui';
import { loadProducts, formatPrice } from '../lib/products';
import { SHOW_PRODUCTS } from '../lib/features';

const t = ui.ko;
const products = loadProducts();
---

<BaseLayout>
  <Hero />

  <InquirySection />

  {SHOW_PRODUCTS && (
  <!-- Products Section -->
  <section id="products" class="section bg-paper dark:bg-night-raised">
    <div class="container-custom">
      <div class="mb-10">
        <h2 class="text-[30px] md:text-[44px] font-bold tracking-[-0.04em]" data-i18n="products.title">{t['products.title']}</h2>
        <p class="mt-3 text-base md:text-lg text-ink-soft dark:text-snow-soft" data-i18n="products.subtitle">{t['products.subtitle']}</p>
      </div>

      {products.length > 0 ? (
        <>
          <!-- Category Filter + Search + Sort -->
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
            <div class="flex flex-wrap gap-2" id="category-filters">
              <button type="button" data-filter="all" class="filter-btn filter-active" aria-pressed="true" data-i18n="products.filterAll">{t['products.filterAll']}</button>
              <button type="button" data-filter="oil" class="filter-btn" aria-pressed="false" data-i18n="products.filterOil">{t['products.filterOil']}</button>
              <button type="button" data-filter="oil-filter" class="filter-btn" aria-pressed="false" data-i18n="products.filterOilFilter">{t['products.filterOilFilter']}</button>
              <button type="button" data-filter="vacuum-filter" class="filter-btn" aria-pressed="false" data-i18n="products.filterVacuumFilter">{t['products.filterVacuumFilter']}</button>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <div class="relative w-full sm:w-60">
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
                </svg>
                <input
                  id="search-input"
                  type="search"
                  class="field w-full pl-10 pr-10"
                  data-i18n-placeholder="products.searchPlaceholder"
                  placeholder={t['products.searchPlaceholder']}
                  aria-label={t['products.searchPlaceholder']}
                />
                <button id="search-clear" type="button" class="focus-ring absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md inline-flex items-center justify-center text-ink-mute hover:text-ink dark:text-snow-mute dark:hover:text-snow hidden" aria-label="Clear">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
              </div>
              <select id="sort-select" class="field w-full sm:w-auto pr-9 cursor-pointer" aria-label={t['products.sortDefault']}>
                <option value="default" data-i18n-option="products.sortDefault">{t['products.sortDefault']}</option>
                <option value="price-asc" data-i18n-option="products.sortPriceAsc">{t['products.sortPriceAsc']}</option>
                <option value="price-desc" data-i18n-option="products.sortPriceDesc">{t['products.sortPriceDesc']}</option>
              </select>
            </div>
          </div>

          <!-- Product Grid -->
          <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
            {products.map((product) => (
              <ProductCard
                partNumber={product.partNumber}
                nameKo={product.nameKo}
                nameEn={product.nameEn}
                image={`/products/images/${product.image}`}
                descriptionKo={product.descriptionKo}
                descriptionEn={product.descriptionEn}
                category={product.category}
                price={formatPrice(product.price)}
                rawPrice={product.price}
                bestSeller={product.bestSeller}
              />
            ))}
          </div>

          <!-- Show More Button -->
          <div id="show-more-wrap" class="text-center mt-10">
            <button id="show-more-btn" type="button" class="btn-secondary">
              <span data-i18n="products.showMore">{t['products.showMore']}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" /></svg>
            </button>
          </div>

          <!-- Empty filter state -->
          <div id="empty-filter" class="hidden text-center py-16">
            <svg class="w-12 h-12 mx-auto mb-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" /></svg>
            <p class="text-lg text-ink-soft dark:text-snow-soft" data-i18n="products.comingSoon">{t['products.comingSoon']}</p>
          </div>
        </>
      ) : (
        <div class="text-center py-16">
          <svg class="w-12 h-12 mx-auto mb-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" /></svg>
          <p class="text-lg text-ink-soft dark:text-snow-soft" data-i18n="products.comingSoon">{t['products.comingSoon']}</p>
        </div>
      )}
    </div>
  </section>
  )}
</BaseLayout>

<script>
  import { ui } from '../i18n/ui';

  // ===================== Search + Category Filter + Sort + Show More =====================
  // All lookups are null-safe: the products section is absent while
  // SHOW_PRODUCTS is false.
  const ITEMS_PER_PAGE = 8;
  const filters = document.getElementById('category-filters');
  const productGrid = document.getElementById('product-grid');
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const emptyFilter = document.getElementById('empty-filter');
  const showMoreWrap = document.getElementById('show-more-wrap');
  const showMoreBtn = document.getElementById('show-more-btn');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear');

  let currentFilter = 'all';
  let currentSort = 'default';
  let currentSearch = '';
  let visibleLimit = ITEMS_PER_PAGE;

  function getSortedFilteredCards(): HTMLElement[] {
    let cards = allCards.filter((card) => {
      // Category filter
      if (currentFilter !== 'all' && card.dataset.category !== currentFilter) return false;

      // Search filter
      if (currentSearch) {
        const nameEl = card.querySelector('.product-name') as HTMLElement | null;
        const nameKo = (nameEl?.dataset.nameKo || '').toLowerCase();
        const nameEn = (nameEl?.dataset.nameEn || '').toLowerCase();
        const partNum = (card.dataset.partNumber || '').toLowerCase();
        if (!nameKo.includes(currentSearch) && !nameEn.includes(currentSearch) && !partNum.includes(currentSearch)) return false;
      }

      return true;
    });

    if (currentSort === 'price-asc') {
      cards.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
    } else if (currentSort === 'price-desc') {
      cards.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
    } else {
      // default: best sellers first, then by original order
      cards.sort((a, b) => {
        const aBest = a.dataset.bestSeller === '1' ? 0 : 1;
        const bBest = b.dataset.bestSeller === '1' ? 0 : 1;
        if (aBest !== bBest) return aBest - bBest;
        return allCards.indexOf(a) - allCards.indexOf(b);
      });
    }

    return cards;
  }

  function applyVisibility() {
    const sorted = getSortedFilteredCards();

    // Reorder DOM elements
    if (productGrid) {
      sorted.forEach((card) => productGrid.appendChild(card));
    }

    allCards.forEach((card) => (card.style.display = 'none'));
    sorted.forEach((card, i) => {
      card.style.display = i < visibleLimit ? '' : 'none';
    });

    if (productGrid && emptyFilter) {
      productGrid.style.display = sorted.length > 0 ? '' : 'none';
      emptyFilter.classList.toggle('hidden', sorted.length > 0);
    }

    if (showMoreWrap) {
      showMoreWrap.style.display = sorted.length > visibleLimit ? '' : 'none';
    }
  }

  applyVisibility();

  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLButtonElement | null;
    if (!btn) return;

    currentFilter = btn.dataset.filter || 'all';
    visibleLimit = ITEMS_PER_PAGE;

    filters.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('filter-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('filter-active');
    btn.setAttribute('aria-pressed', 'true');

    applyVisibility();
  });

  sortSelect?.addEventListener('change', () => {
    currentSort = sortSelect.value;
    visibleLimit = ITEMS_PER_PAGE;
    applyVisibility();
  });

  showMoreBtn?.addEventListener('click', () => {
    visibleLimit += ITEMS_PER_PAGE;
    applyVisibility();
  });

  searchInput?.addEventListener('input', () => {
    currentSearch = (searchInput.value || '').trim().toLowerCase();
    visibleLimit = ITEMS_PER_PAGE;
    if (searchClear) {
      searchClear.classList.toggle('hidden', !currentSearch);
    }
    applyVisibility();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    searchClear.classList.add('hidden');
    visibleLimit = ITEMS_PER_PAGE;
    applyVisibility();
  });

  // ===================== Card Flip =====================
  productGrid?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.card-flip') as HTMLElement | null;
    if (!card) return;
    card.classList.toggle('flipped');
  });

  // ===================== Language Toggle =====================
  const btnKO = document.getElementById('btnKO')!;
  const btnEN = document.getElementById('btnEN')!;

  function setLang(lang: 'ko' | 'en') {
    // Update KO / EN segmented switch
    btnKO.classList.toggle('lang-active', lang === 'ko');
    btnEN.classList.toggle('lang-active', lang === 'en');
    btnKO.setAttribute('aria-pressed', String(lang === 'ko'));
    btnEN.setAttribute('aria-pressed', String(lang === 'en'));

    // Update html lang attribute
    document.documentElement.lang = lang;

    // Update all data-i18n elements
    const translations = ui[lang];
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n as keyof typeof translations;
      const value = translations[key] || ui.ko[key];
      if (!value) return;

      if (el.tagName === 'TITLE') {
        document.title = value;
      } else if (el.tagName === 'META') {
        el.setAttribute('content', value);
      } else if (el.hasAttribute('data-i18n-html')) {
        // Only ever fed our own constant strings from src/i18n/ui.ts.
        el.innerHTML = value;
      } else {
        el.textContent = value;
      }
    });

    // Update select option elements
    document.querySelectorAll<HTMLOptionElement>('[data-i18n-option]').forEach((el) => {
      const key = el.dataset.i18nOption as keyof typeof translations;
      const value = translations[key] || ui.ko[key];
      if (value) el.textContent = value;
    });

    // Update placeholder attributes
    document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nPlaceholder as keyof typeof translations;
      const value = translations[key] || ui.ko[key];
      if (value) {
        (el as HTMLInputElement).placeholder = value;
        el.setAttribute('aria-label', value);
      }
    });

    // Update product names and descriptions
    document.querySelectorAll<HTMLElement>('.product-name').forEach((el) => {
      el.textContent = (lang === 'ko' ? el.dataset.nameKo : el.dataset.nameEn) || '';
    });
    document.querySelectorAll<HTMLElement>('.product-desc').forEach((el) => {
      el.textContent = (lang === 'ko' ? el.dataset.descKo : el.dataset.descEn) || '';
    });

    // Update Leybold links to language-specific URL
    const leyboldUrl = lang === 'ko' ? 'https://www.leybold.com/ko-kr' : 'https://www.leybold.com/en';
    document.querySelectorAll<HTMLAnchorElement>('[data-leybold-link]').forEach((el) => {
      el.href = leyboldUrl;
    });
  }

  btnKO.addEventListener('click', () => setLang('ko'));
  btnEN.addEventListener('click', () => setLang('en'));
</script>
