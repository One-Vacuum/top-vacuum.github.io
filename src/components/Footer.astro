---
import { ui } from '../i18n/ui';
import { SHOW_PRODUCTS } from '../lib/features';

const t = ui.ko;
---

<footer class="border-t border-line dark:border-night-line">
  <div class="container-custom py-12 md:py-14 flex flex-col md:flex-row md:justify-between gap-10">
    <!-- Company Info + Quick Links -->
    <div class="flex flex-col gap-2">
      <span class="font-display text-xl font-extrabold tracking-[0.01em] text-ink dark:text-snow">TOP VACUUM</span>
      <p class="text-sm text-ink-mute dark:text-snow-mute" data-i18n="site.description" data-i18n-html set:html={t['site.description']}></p>
      <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold" aria-label="Footer">
        <a href="#" class="focus-ring rounded-sm text-ink-soft hover:text-accent dark:text-snow-soft dark:hover:text-accent-light transition-colors" data-i18n="nav.home">{t['nav.home']}</a>
        {SHOW_PRODUCTS && (
          <a href="#products" class="focus-ring rounded-sm text-ink-soft hover:text-accent dark:text-snow-soft dark:hover:text-accent-light transition-colors" data-i18n="nav.products">{t['nav.products']}</a>
        )}
        <a href="#contact" class="focus-ring rounded-sm text-ink-soft hover:text-accent dark:text-snow-soft dark:hover:text-accent-light transition-colors" data-i18n="nav.contact">{t['nav.contact']}</a>
      </nav>
    </div>

    <!-- Business info -->
    <div class="text-xs leading-[1.9] text-ink-mute dark:text-snow-mute md:text-right">
      <p>
        <span data-i18n="footer.company">{t['footer.company']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="footer.owner">{t['footer.owner']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="footer.bizNo">{t['footer.bizNo']}</span>
      </p>
      <p>
        <span data-i18n="contact.addressValue">{t['contact.addressValue']}</span>
      </p>
      <p>
        <span data-i18n="contact.phoneValue">{t['contact.phoneValue']}</span>
        <span class="mx-1.5" aria-hidden="true">·</span>
        <span data-i18n="contact.mobileValue">{t['contact.mobileValue']}</span>
        <span class="mx-1.5" aria-hidden="true">·</span>
        <span data-i18n="contact.emailValue">{t['contact.emailValue']}</span>
      </p>
      <p class="mt-2" data-i18n="footer.copyright">{t['footer.copyright']}</p>
    </div>
  </div>
</footer>
