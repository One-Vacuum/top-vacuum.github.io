---
// Inquiry form + preview dialog, i.e. the markup src/lib/inquiry-form.ts
// binds to. Identical in top-vacuum.github.io and one-vacuum.github.io —
// change both. Fields come from INQUIRY_FIELDS (src/lib/inquiry-config.ts);
// each site wraps this in its own section and styles `.input`,
// `.field-error`, `.inquiry-status`, `.inquiry-preview` and
// `.inquiry-preview-label` in global.css.
import { ui } from '../i18n/ui';
import { INQUIRY_FIELDS } from '../lib/inquiry-config';

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const t = ui.ko;
const label = (key: string) => t[key as keyof typeof t];
const halves = INQUIRY_FIELDS.filter((f) => !('wide' in f && f.wide));
const wides = INQUIRY_FIELDS.filter((f) => 'wide' in f && f.wide);
---

<!-- method="post" keeps typed details out of the URL if the script never loads. -->
<form id={id} method="post" data-inquiry-form novalidate class:list={['flex flex-col gap-5', className]}>
  <!-- Honeypot for bots; hidden from people and assistive tech -->
  <div class="hidden" aria-hidden="true" data-honeypot>
    <label>Leave this empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
  </div>

  {[halves, wides].map((group, i) => (
    <div class:list={['grid gap-5', i === 0 && 'sm:grid-cols-2']}>
      {group.map((f) => (
        <div class="flex flex-col gap-1.5">
          <label for={`iq-${f.name}`} class="text-[13px] font-bold text-ink dark:text-snow">
            <span data-i18n={f.labelKey}>{label(f.labelKey)}</span>
            {!f.required && <span class="font-medium text-ink-mute dark:text-snow-mute" data-i18n="inquiry.optional">{t['inquiry.optional']}</span>}
          </label>
          {f.control === 'textarea' ? (
            <textarea
              id={`iq-${f.name}`}
              name={f.name}
              rows="6"
              maxlength={f.maxLength}
              required={f.required}
              aria-describedby={`iq-${f.name}-error`}
              class="input h-auto py-3 resize-y"
            ></textarea>
          ) : (
            <input
              id={`iq-${f.name}`}
              name={f.name}
              type={f.type}
              autocomplete={'autocomplete' in f ? f.autocomplete : undefined}
              maxlength={f.maxLength}
              required={f.required}
              aria-describedby={`iq-${f.name}-error`}
              class="input"
              data-i18n-placeholder={'placeholderKey' in f ? f.placeholderKey : undefined}
              placeholder={'placeholderKey' in f ? label(f.placeholderKey) : undefined}
            />
          )}
          <p id={`iq-${f.name}-error`} data-error-for={f.name} class="field-error"></p>
        </div>
      ))}
    </div>
  ))}

  <button type="submit" class="btn-primary w-full aria-disabled:opacity-60 aria-disabled:cursor-wait">
    <span data-i18n="inquiry.submit">{t['inquiry.submit']}</span>
  </button>
  <p data-inquiry-status role="status" aria-live="polite" tabindex="-1" class="inquiry-status"></p>
</form>

<!-- Off production (localhost, preview builds): shows the email that would be sent. -->
<dialog data-inquiry-preview class="inquiry-preview" aria-labelledby={`${id}-preview-title`} lang="ko">
  <form method="dialog" class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="inquiry-preview-label" lang="en">Preview</p>
        <h3 id={`${id}-preview-title`} class="mt-1 text-lg font-bold">사장님이 받게 될 메일 (실제로 발송되지 않음)</h3>
      </div>
      <button type="submit" class="icon-btn shrink-0" aria-label={t['a11y.close']} data-i18n-aria-label="a11y.close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <dl class="grid grid-cols-[80px_minmax(0,1fr)] gap-x-3 gap-y-1 text-sm">
      <dt class="text-ink-mute dark:text-snow-mute">받는 사람</dt><dd data-preview="to"></dd>
      <dt class="text-ink-mute dark:text-snow-mute">답장 주소</dt><dd data-preview="replyTo"></dd>
      <dt class="text-ink-mute dark:text-snow-mute">제목</dt><dd class="font-semibold" data-preview="subject"></dd>
    </dl>
    <table class="w-full text-sm border border-line dark:border-night-line">
      <caption class="sr-only">메일 본문</caption>
      <tbody data-preview="rows"></tbody>
    </table>
  </form>
</dialog>

<script>
  import { initInquiryForms } from '../lib/inquiry-form';

  initInquiryForms();
</script>
